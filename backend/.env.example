PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=smartattend-enterprise-super-secret-key-2026-secure
JWT_SECRET_KEY=smartattend-jwt-auth-token-signature-key-2026
JWT_EXPIRATION_HOURS=24
DATABASE_URL=sqlite:///smartattend.db

# AI & Biometrics Configuration
FACE_CONFIDENCE_THRESHOLD=0.68
ANTI_SPOOFING_THRESHOLD=0.75
LIVENESS_MODE=HYBRID_CNN_TEXTURE  # HYBRID_CNN_TEXTURE, STRICT_CNN, SIMULATION
MAX_FACES_ALLOWED=1
MIN_FACE_SIZE=60

# Office Time Rules
OFFICE_START_TIME=09:00
LATE_GRACE_PERIOD_MINUTES=15
OFFICE_END_TIME=17:00
